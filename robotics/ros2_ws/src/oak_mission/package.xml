  <description>Validated local-language missions for a simulated Nav2 robot.</description>
  <maintainer email="maintainers@example.invalid">OakGPT contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav2_msgs</exec_depend>
