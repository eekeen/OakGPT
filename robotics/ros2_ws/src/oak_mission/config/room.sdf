<?xml version="1.0"?>
<sdf version="1.9">
  <world name="oak_room">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.01</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -1</direction></light>
    <model name="floor"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></visual>
    </link></model>
    <model name="north"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="wall">
      <collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="south"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="wall">
      <collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="east"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="wall">
      <collision name="c"><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.2 1</size></box></geometry></visual></link></model>
    <model name="west"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="wall">
      <collision name="c"><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8.2 1</size></box></geometry></visual></link></model>
    <model name="oak_robot"><pose>0 0 0.12 0 0 0</pose>
      <link name="base_link"><inertial><mass>4</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.06</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.30 0.25 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.30 0.25 0.12</size></box></geometry></visual>
        <sensor name="laser" type="gpu_lidar"><pose>0 0 0.15 0 0 0</pose>
          <topic>/scan</topic><gz_frame_id>base_scan</gz_frame_id><update_rate>10</update_rate>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal></scan>
            <range><min>0.10</min><max>10</max><resolution>0.01</resolution></range></lidar>
          <always_on>true</always_on><visualize>false</visualize>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.15 -0.04 1.57079632679 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.03</length></cylinder></geometry></visual></link>
      <link name="right_wheel"><pose>0 -0.15 -0.04 1.57079632679 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.03</length></cylinder></geometry></visual></link>
      <link name="caster"><pose>-0.11 0 -0.09 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision></link>
      <joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
        <wheel_separation>0.30</wheel_separation><wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.22</max_linear_velocity><max_angular_velocity>0.8</max_angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
